# ============ FRONTEND (Vite) ============
# Biarkan kosong kalau API & frontend di-deploy di Netlify yang sama (pakai /api).
# Isi hanya kalau API-mu ada di domain lain.
# VITE_API_URL=https://your-site.netlify.app/api

# ============ BACKEND (Netlify Functions / lokal) ============
# Connection string Postgres dari Railway:
#   Railway -> project -> Postgres -> Variables -> DATABASE_URL (atau "Postgres Connection URL")
DATABASE_URL=postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway

# Set "false" hanya untuk Postgres lokal tanpa SSL. Untuk Railway biarkan default (SSL on).
DATABASE_SSL=true

# Secret untuk tanda tangan JWT (bebas, buat acak & panjang).
JWT_SECRET=ganti-dengan-string-acak-panjang
